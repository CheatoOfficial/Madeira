diff --git a/Source/Windows/ARM64EC/CMakeLists.txt b/Source/Windows/ARM64EC/CMakeLists.txt
index 0000000..0000000 100644
--- a/Source/Windows/ARM64EC/CMakeLists.txt
+++ b/Source/Windows/ARM64EC/CMakeLists.txt
@@ -58,3 +58,7 @@
   target_link_options(arm64ecfex PRIVATE -static)
+  # The static archives later on this link line introduce libc++ references
+  # after the normal runtime scan. Include runtime members up front so those
+  # ARM64EC references are available to the complete link.
+  target_link_libraries(arm64ecfex PRIVATE -Wl,--whole-archive c++ c++abi unwind -Wl,--no-whole-archive)
 else()
   target_link_options(arm64ecfex PRIVATE -static -nostdlib -nostartfiles -nodefaultlibs -lc++ -lc++abi -lunwind)
